{
  "name": "unisynth",
  "version": "1.0.0",
  "description": "Collaborative mesh/VR camera app for multi-device 3D scene capture",
  "private": true,
  "workspaces": [
    "backend",
    "mobile",
    "viewer"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../mobile && npm install && cd ../viewer && npm install",
    "start:backend": "cd backend && npm start",
    "start:mobile": "cd mobile && npm start",
    "start:viewer": "cd viewer && npm run dev",
    "test": "npm run test --workspaces",
    "clean": "rm -rf node_modules backend/node_modules mobile/node_modules viewer/node_modules"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Seekzest/Unisynth.git"
  },
  "keywords": [
    "3d",
    "vr",
    "camera",
    "mesh",
    "collaborative",
    "mobile",
    "reconstruction"
  ],
  "author": "Seekzest",
  "license": "MIT"
}
