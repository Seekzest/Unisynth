# MinIO / S3 settings
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=unisynth-dev

# Server settings
SERVER_PORT=3000
DATA_DIR=./data
PRESIGN_EXPIRY_SEC=900

# Redis (optional). If set, Bull queue will be used. Otherwise file-based job queue used.
REDIS_URL=redis://redis:6379

# JWT secret (optional for auth)
JWT_SECRET=change-me
